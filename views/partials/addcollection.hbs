<form class="ui stacked segment form" action="/dashboard/addcollection" method="POST" enctype="multipart/form-data">
 <div class="three fields">
  <div class="field">
    <label>Name</label>
    <input placeholder="Name" type="text" name="name" autofocus required>
  </div>
  <div class="field">
    <label>Rating</label>
    <input placeholder="Rating" type="number" name="rating" min="0" max="5">
  </div>
  <div class="field">
      <label>Image</label>
      <input placeholder="Image" type="file" name="picture" required>
    </div>
    </div>
 <button class="ui orange submit button">Add Collection</button>
</form>
