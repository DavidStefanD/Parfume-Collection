<section class="ui left aligned middle aligned segment">

  {{> dashboardHeader }}

  {{#unless search}}
    {{#unless parfumeCollection}}
      <h3 class="ui message">
        Start adding your parfume collections!
      </h3>
    {{/unless}}
  {{/unless}}

  <div class="ui centered cards">
    
    {{#each parfumeCollection}}
      {{> collectionCard}}
    {{/each}}
    
  </div>

</section>