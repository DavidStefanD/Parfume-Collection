 {{#if parfumes}}

  <table class="ui unstackable striped table">
    <thead>
      <tr>
        <th class="four wide">Parfumes</th>
        <th class="four wide">Brand</th>
        <th class="two wide"> </th>
        <th class="two wide"> </th>
      </tr>
    </thead>
  <tbody>
      {{#each parfumes}}
        {{> listOneParfume collectionId=../id}}
        {{> editParfume collectionId=../id}}

        <script>
    document.querySelector("#showEdit{{@index}}").addEventListener ('click', () => {
        document.querySelector("#parfume{{@index}}").style.display = "none";
        document.querySelector("#edit{{@index}}").style.display = "table-row";
    })
    document.querySelector("#hideEdit{{@index}}").addEventListener ('click', () => {
        document.querySelector("#parfume{{@index}}").style.display = "table-row";
        document.querySelector("#edit{{@index}}").style.display = "none";
    })
</script>

        {{/each}}
        
      
    </tbody>
  </table>

{{else}}
  <h3 class="ui message">
    Empty parfume collection!
  </h3>

{{/if}}




