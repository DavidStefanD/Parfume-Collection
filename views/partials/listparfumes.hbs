{{#if singleParfume.parfumes}}

  <table class="ui unstackable striped table">
    <thead>
      <tr>
        <th>Parfume</th>
        <th>Brand</th>
      </tr>
    </thead>
    <tbody>
      {{#each singleParfume.parfumes}}
        <tr>
          <td>
            {{name}}
          </td>
          <td>
            {{brand}}
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  {{else}}
    <h3 class="ui message">
      Empty parfume collection - Work in progress!
    </h3>

{{/if}}


