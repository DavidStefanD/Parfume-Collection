<form class="ui stacked segment form" action="/parfume-collection/{{id}}/addparfume" method="POST">
  <div class="two fields">
    <div class="field">
      <label>Name</label>
      <input type="text" name="name" autofocus required title = "Please include a valid Name"
	  placeholder="Name">
    </div>
    <div class="field">
      <label>Brand</label>
      <input type="text" name="brand" required title = "Please include a valid Brand"
	  placeholder="Brand"  >
    </div>
  </div>
  <button class="ui orange submit button">Add Parfume</button>
</form>
