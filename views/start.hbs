{{> menu}}

<section class="ui center aligned middle aligned segment">
  <h2>Welcome to My Parfume Collection!</h2>
    <p>
      Discover the collection of parfumes I built.
    </p>

    <img src = "/poza.jpeg" class = "ui centered image">

     <div class="ui four statistics" style="margin-top: 1em;">
    
    {{#with info}}


    <div class="statistic">
      <div class="value">
        <i class="flask icon"></i>
      </div>
      <div class="label">
        App Title: <br>
        {{appTitle}}
      </div>
    </div>
    
    <!-- Other statistics will go here -->
       <div class="statistic">
      <div class="value">
        <i class="code branch icon"></i> 
      </div>
      <div class="label">
        App Version: <br>
        Version {{version}}
      </div>
    </div>    
    <div class="statistic">
      <div class="value">
        <i class="map pin icon"></i> 
      </div>
      <div class="label">
        Made in: <br>
        {{location}}
      </div>
    </div>    
    <div class="statistic">
      <div class="value">
        <i class="user icon"></i> 
      </div>
      <div class="label">
        Created by: <br>
        {{creators.0.name}}
      </div>
    </div> 
  {{/with}}
  </div>

</section>
 


